Options -Indexes

<FilesMatch "\.(env|ini|log|sql|bak|old|orig|dist|pem|key)$">
    Require all denied
</FilesMatch>

<FilesMatch "(?i)(^\.env(?:\..*)?$|(?:^|[._-])(?:backup|backups|dump|seed)(?:[._-]|$)|~$|\.swp$)">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^\.(?:git|github|svn|hg)(?:/|$) - [F,L,NC]
RewriteRule ^(?:config|database|includes|cron|logs|backups?)(?:/|$) - [F,L,NC]
